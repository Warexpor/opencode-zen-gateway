# Optional. If unset, the harness Authorization / API key is forwarded as-is.
# OPENCODE_API_KEY=oc-...

# ZEN_GATEWAY_PORT=8789
# ZEN_GATEWAY_CLIENT=cli
# ZEN_GATEWAY_PROJECT=global
# ZEN_GATEWAY_OPENCODE_VERSION=1.18.31

# Upstream SOCKS5: use proxy-on.bat / proxy-off.bat (writes socks5.url).
# Or force: ZEN_GATEWAY_SOCKS5=socks5://127.0.0.1:10808
